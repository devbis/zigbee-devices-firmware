# Copy to scripts/env.local (ignored by git) and fill in. Variables already
# set in the environment win over these, so the file is optional.

# The Zephyr tree
: "${ZEPHYR_BASE:=/path/to/zephyr}"

# LLVM that compiles for the TC32 target (the directory with bin/clang)
: "${LLVM_TOOLCHAIN_PATH:=/path/to/llvm}"

# Extra Zephyr modules, here zephyr-iot-drivers (drivers and libraries)
: "${ZEPHYR_EXTRA_MODULES:=/path/to/zephyr-iot-drivers}"

# west and a Python with the imgtool requirements (default: from PATH)
#: "${WEST:=/path/to/venv/bin/west}"
#: "${PYTHON:=/path/to/venv/bin/python}"

# MCUboot module (default: bootloader/mcuboot in the west workspace)
#: "${MCUBOOT_DIR:=/path/to/mcuboot}"
