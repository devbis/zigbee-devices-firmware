/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Tuya ZT3L module (TLSR8258, 512 KiB flash) on a floor-heating thermostat:
 * its only job is to talk to the thermostat's own MCU over UART0, 9600 baud,
 * TX on PB1 and RX on PB7. The module has no button and no LED.
 */

#include <zephyr/dt-bindings/pinctrl/tlsr8258-pinctrl.h>

/ {
	aliases {
		tuya-uart = &uart0;
		/delete-property/ led0;
	};

	chosen {
		/delete-property/ zephyr,console;
	};
};

&led0 {
	status = "disabled";
};

&pinctrl {
	uart0_rx_pb7: uart0_rx_pb7 {
		pinmux = <TLSR8258_PINMUX(TLSR8258_GPIO_PB7, TLSR8258_FUNC_UART)>;
		bias-pull-up;
		input-enable;
	};
};

&uart0 {
	status = "okay";
	current-speed = <9600>;
	rx-pin = <TLSR8258_GPIO_PB7>;
	pinctrl-0 = <&uart0_tx_default &uart0_rx_pb7>;
};

&zb {
	status = "okay";
};
